  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "husky": "^9.1.7",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-astro": "^2.0.0",
    "stylelint-config-standard": "^40.0.0"
